class Solution {
public:
    int countServers(vector<vector<int>>& grid) {
        set<pair<int,int>> ans;
        for(int i=0;i<grid.size();i++)
        {
           set<pair<int,int>> temp;
           for(int j=0;j<grid[i].size();j++)
           {
            if(grid[i][j]==1)
            temp.insert({i,j});
           }
            if(temp.size()>1)
            {
                for(auto &it: temp)
                ans.insert(it);
            }
        }
        for(int i=0;i<grid[0].size();i++)
        {
           set<pair<int,int>> temp;
           for(int j=0;j<grid.size();j++)
           {
            if(grid[j][i]==1)
            temp.insert({j,i});
           }
            if(temp.size()>1)
            {
                for(auto &it: temp)
                ans.insert(it);
            }
        }
        return ans.size();
    }
};
