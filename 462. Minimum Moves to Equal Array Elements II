class Solution {
public:
    int minMoves2(vector<int>& nums) {
        if(nums.size()==1)
        return 0;
        sort(nums.begin(),nums.end());
        if(nums.size()%2!=0)
        {
            int ans=0;
            for(int i=0;i<nums.size();i++)
            ans+=abs(nums[i]-nums[nums.size()/2]);
            return ans;
        }
        int median=(nums[nums.size()/2]+nums[nums.size()/2-1])/2;
        int ans=0;
            for(int i=0;i<nums.size();i++)
            ans+=abs(nums[i]-median);
            return ans;
    }
};
