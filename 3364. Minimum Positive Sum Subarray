class Solution {
public:
    int minimumSumSubarray(vector<int>& nums, int l, int r) {
        int ans=INT_MAX;
        for(int i=l;i<=r;i++)
        {
            int right=i-1;
            int left=0;
            int temp=0;
            for(int j=0;j<right;j++)
            {
                temp+=nums[j];
            }
            while(right<nums.size())
            {
                temp+=nums[right];
                if(temp>0)
                ans=min(ans,temp);
                temp-=nums[left];
                left++;
                right++;
            }
        }
        if(ans==INT_MAX)
        return -1;
        return ans;
    }
};
