class Solution {
public:
    long long minimumCost(int cost1, int cost2, int costBoth, int need1, int need2) {
        long long comb=cost1+cost2;
        long long ans=0;
        if(comb<=costBoth)
        {
            ans+=1LL*min(need1,need2)*comb;
        }
        else
        {
            ans+=1LL*min(need1,need2)*costBoth;
        }
        if(need1>need2)
        {
            if(costBoth<cost1)
            {
                ans+=1LL*(need1-need2)*costBoth;
            }
            else
            {
                ans+=1LL*(need1-need2)*cost1;
            }
        }
        else if(need2>need1)
        {
            if(costBoth<cost2)
            {
                ans+=1LL*(need2-need1)*costBoth;
            }
            else
            {
                ans+=1LL*(need2-need1)*cost2;
            }
        }
        return ans;
    }
};
