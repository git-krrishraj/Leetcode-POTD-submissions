class Solution {
public:
    int type(int n)
    {
        if(n<0)
        return -1;
        else if(n>0)
        return 1;
        return 0;
    }
    int longestMonotonicSubarray(vector<int>& nums) {
        if(nums.size()==1)
        return 1;
        vector<int> v;
        for(int i=1;i<nums.size();i++)
        {
            v.push_back(nums[i]-nums[i-1]);
        }
        int mi=1,md=1;
        if(type(v[0])==-1)
        md=2;
        else if(type(v[0])==1)
        mi=2;
        int ct=1;
        for(int i=1;i<v.size();i++)
        {
            if(type(v[i])!=type(v[i-1]))
            {
                if(type(v[i-1])==-1)
                md=max(ct+1,md);
                else if(type(v[i-1])==1)
                mi=max(ct+1,mi);
                ct=1;
            }
            else
            ct++;
        }
        if(type(v.back())==-1)
        {
            md=max(ct+1,md);
        }
        else if(type(v.back())==1)
        mi=max(ct+1,mi);
        return max({mi,md,1});
    }
};
